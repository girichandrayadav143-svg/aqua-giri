# ============================================================================
# AQUA FARMING SYSTEM - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (contains secrets)

# ============================================================================
# Server Configuration
# ============================================================================
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ============================================================================
# Database Configuration
# ============================================================================
# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/aqua_farming

# MongoDB Atlas (Cloud - Recommended for Production)
# Get your connection string from https://www.mongodb.com/cloud/atlas
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aqua_farming?retryWrites=true&w=majority

# ============================================================================
# Authentication & Security
# ============================================================================
# JWT Secret Key (IMPORTANT: Use a strong, random string in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=aqua_farming_secret_jwt_key_2026

# JWT Token Expiration
JWT_EXPIRY=7d

# ============================================================================
# CORS Configuration
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,https://aquafarms.com

# ============================================================================
# API Configuration
# ============================================================================
API_BASE_URL=http://localhost:5000
API_VERSION=v1

# ============================================================================
# Frontend Configuration
# ============================================================================
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_JWT_KEY=manthena_aqua_jwt
REACT_APP_USER_KEY=manthena_aqua_user

# ============================================================================
# Logging & Debugging
# ============================================================================
LOG_LEVEL=info
DEBUG=false

# ============================================================================
# Third-Party Services (Optional)
# ============================================================================
# Firebase (if using Firebase Auth)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Email Service (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@aquafarms.com

# ============================================================================
# Analytics & Monitoring (Optional)
# ============================================================================
SENTRY_DSN=
GOOGLE_ANALYTICS_ID=

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME=AQUA FARMING
APP_DOMAIN=aquafarms.com
MAX_LOGIN_ATTEMPTS=5
PASSWORD_RESET_TIMEOUT=3600
SESSION_TIMEOUT=86400

# ============================================================================
# Database Backup & Maintenance
# ============================================================================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
MAINTENANCE_WINDOW=02:00-03:00

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_PWA=true
FEATURE_OFFLINE_MODE=true
FEATURE_ADMIN_PANEL=true
FEATURE_MULTI_USER=true
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_SMS_ALERTS=false

# ============================================================================
# Production Deployment (Render/Railway/Heroku)
# ============================================================================
# Render.com
# RENDER_SERVICE_ID=your-service-id

# Railway.app
# RAILWAY_ENVIRONMENT=production

# Heroku
# HEROKU_API_KEY=your-api-key
# HEROKU_APP_NAME=aqua-farming-prod

# ============================================================================
# Development Only Settings
# ============================================================================
SEED_DATABASE=false
DEMO_MODE=false
ENABLE_TEST_ROUTES=false
